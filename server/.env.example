# In production, append ?connection_limit=10&pool_timeout=20 (or tune those
# two numbers to your actual container size and DB plan's pooler cap) —
# without it, Prisma sizes its pool from a CPU-count heuristic that can land
# on as few as 3-5 connections on a small container, well below what the
# app needs under real concurrent traffic. Not needed locally.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="change-me-to-something-random"
# Required in production. Shared rate-limit counters keep abuse controls
# consistent when more than one API instance is running.
REDIS_URL="redis://user:password@host:6379"
PORT=4000
NODE_ENV="development"
# Comma-separated list of extra allowed frontend origins, e.g. deployed static hosts.
# Local dev on any localhost/127.0.0.1 port is always allowed automatically.
EXTRA_CLIENT_ORIGINS=""
# Fraction of successful requests logged in production. Errors and requests
# slower than one second are always logged. Defaults to 0.01 in production.
REQUEST_LOG_SAMPLE_RATE="0.01"

RESEND_API_KEY=""
# Sandbox sender until a domain is verified in Resend — can only deliver to
# the Resend account's own signup email. Swap to an address on your verified
# domain (e.g. outreach@yourdomain.com) once that's set up.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Enables inbound replies on gig-inquiry email threads (server/src/routes/emailWebhooks.js).
# Requires the domain's MX record configured for receiving in Resend's
# dashboard (Domains > your domain > Inbound), plus a webhook there
# (Webhooks > Add webhook) pointed at <this server's URL>/api/webhooks/resend
# listening for the email.received event, whose signing secret goes below.
RESEND_INBOUND_DOMAIN=""
RESEND_WEBHOOK_SECRET=""

# Base URL of the deployed frontend — used to build the link inside
# password-reset emails. Defaults to local dev if unset.
FRONTEND_URL="http://localhost:5173"
# Public HTTPS origin of this API. Required for provider callback URLs and
# signature validation when the app is behind Railway's proxy.
API_PUBLIC_URL="http://localhost:4000"

# Dedicated Gigworks SMS numbers. These are platform credentials—customers
# never enter or see them. Each approved account number is assigned from the
# platform admin account profile after carrier registration.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Where new support messages notify the platform admin. Change as
# hosting/business details evolve — not tied to any account.
SUPPORT_NOTIFICATION_EMAIL="shayalieberman@gmail.com"

# Enables billing/invoicing via Stripe Connect (server/src/routes/billing.js,
# server/src/routes/invoices.js). Get the secret key from the Stripe
# Dashboard (test mode to start) > Developers > API keys.
STRIPE_SECRET_KEY=""
# Get this from Dashboard > Developers > Webhooks > Add endpoint, pointed at
# <this server's URL>/api/webhooks/stripe, listening for the
# checkout.session.completed and account.updated events. That endpoint must
# have "Listen to events on Connected accounts" enabled — both event types
# are reported as connected-account events, not platform events, since
# Checkout Sessions here are created directly on each business's own
# connected Stripe account (server/src/routes/stripeWebhooks.js).
STRIPE_WEBHOOK_SECRET=""

# GigWorks' own subscription billing (what a business pays GigWorks — see
# server/src/lib/plans.js) — a separate concern from the Stripe Connect
# vars above (what a business's clients pay them). Run
# `npm run setup:billing-plans` (from server/) to create all of this on
# Stripe and print the values below, rather than setting them by hand.
STRIPE_PRICE_SOLO_MONTHLY=""
STRIPE_PRICE_SOLO_ANNUAL=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_ANNUAL=""
STRIPE_PRICE_STUDIO_MONTHLY=""
STRIPE_PRICE_STUDIO_ANNUAL=""
# Signing secret for the webhook endpoint setup:billing-plans creates,
# pointed at <this server's URL>/api/webhooks/stripe-billing — a platform-
# level endpoint (NOT "listen to connected accounts"), unlike
# STRIPE_WEBHOOK_SECRET above. See server/src/routes/subscriptionWebhooks.js.
STRIPE_BILLING_WEBHOOK_SECRET=""

# Uploaded file storage (server/src/lib/fileStorage.js) — Supabase Storage,
# same project as DATABASE_URL. Get URL and the service_role secret key
# (not anon) from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional — defaults to "documents". Created automatically on first upload.
SUPABASE_STORAGE_BUCKET=""

# Storage migration controls. Leave STORAGE_PROVIDER=supabase until the
# Railway bucket variables below are configured. During migration, use
# railway + STORAGE_FALLBACK_SUPABASE=true so new files land in Railway while
# older objects remain readable from Supabase until the copy is verified.
STORAGE_PROVIDER="supabase"
STORAGE_FALLBACK_SUPABASE="false"
AWS_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_DEFAULT_REGION="auto"
AWS_S3_URL_STYLE="virtual"

# Optional — error monitoring (src/index.js). Leave blank locally; the SDK
# silently no-ops with no DSN. Same Sentry project as the frontend's
# VITE_SENTRY_DSN works fine (Sentry separates by platform within a
# project) — set this in Railway's env vars once configured.
SENTRY_DSN=""
# Optional release identifiers used to correlate errors with deployments.
# Railway supplies RAILWAY_GIT_COMMIT_SHA automatically. Set VITE_RELEASE_SHA
# to the deployed commit in the frontend build environment.
RELEASE_SHA=""
