generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  firstName           String
  lastName            String
  email               String               @unique
  phone               String?
  passwordHash        String?
  googleId            String?              @unique
  // App operators, not signup-settable. isPlatformAdmin is grantable/revocable
  // by existing admins (server/src/routes/admin.js); isPlatformOwner is the
  // one admin who can never be revoked by anyone else — flipped manually,
  // never through any API.
  isPlatformAdmin     Boolean              @default(false)
  isPlatformOwner     Boolean              @default(false)
  // Scoped platform-admin capabilities — { manageAccounts, manageAccountStatus,
  // manageSupport, manageAdmins }, all booleans. Only meaningful when
  // isPlatformAdmin is true. isPlatformOwner always bypasses this (see
  // requireAdminPermission in server/src/lib/membership.js).
  adminPermissions    Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  membership          Membership?
  passwordResetTokens PasswordResetToken[]
  supportNotes        SupportNote[]
  assignedThreads     SupportThread[]
  disabledAccounts    Account[]            @relation("AccountDisabledBy")
  approvedAccounts    Account[]            @relation("AccountApprovedBy")
  reminders           Reminder[]
}

model Account {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  disabledAt              DateTime? // set by a platform admin; blocks all account access when non-null
  // Auditability for the disable action above — who disabled it, and why.
  // All three (disabledAt/disabledReason/disabledById) are cleared together
  // when the account is re-enabled.
  disabledReason          String?                  @db.Text
  disabledById            String?
  disabledBy              User?                    @relation("AccountDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)
  // Public self-signups (auth.js's POST /signup) require manual review
  // during the current probationary period — null blocks account access
  // the same way disabledAt does (see membership.js's attachMembership),
  // just for a different reason ("never yet reviewed" vs. "explicitly
  // disabled"), so admin/support UI can tell the two apart. Every other
  // account-creation path (admin-created accounts, admin invites, the
  // legacy pre-Account auto-provisioning path) sets this immediately —
  // they were never really "unreviewed" the way a cold self-signup is.
  approvedAt              DateTime?
  approvedById            String?
  approvedBy              User?                    @relation("AccountApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  memberships             Membership[]
  emailThreads            EmailThread[]
  eventDocuments          EventDocument[]
  bookingDocuments        BookingDocument[]
  contracts               Contract[]
  proposalResponses       ProposalResponse[]
  invoices                Invoice[]
  inquiryLinks            InquiryLink[]
  accountData             AccountData?
  supportThreads          SupportThread[]
  reminders               Reminder[]
  emailDomain             EmailDomain?
  stagePlots              StagePlot[]
  floorPlans              FloorPlan[]
  guests                  Guest[]
  eventRsvpLinks          EventRsvpLink[]
  contractorCalendarLinks ContractorCalendarLink[]
  contractors             Contractor[]
  clients                 Client[]
  bookings                Booking[]
  events                  Event[]

  // Stripe Connect (Express) — set once onboarding starts. The three
  // booleans are a local cache of the connected Account object, synced by
  // account.updated webhooks (server/src/routes/stripeWebhooks.js) and by a
  // manual refresh right after the onboarding redirect back into the app
  // (server/src/routes/billing.js), since webhooks can lag that redirect by
  // a few seconds. chargesEnabled (not just stripeAccountId being set) is
  // what every invoice-sending code path actually checks, since Stripe can
  // flag a previously-connected account and revoke it later.
  stripeAccountId        String? @unique
  stripeDetailsSubmitted Boolean @default(false)
  stripeChargesEnabled   Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)

  // Running invoice-numbering sequence and sticky footer memo — carried
  // into each new invoice's composer as a default, and advanced/updated
  // whenever an invoice is created or edited with an explicit number/memo.
  // See server/src/routes/invoices.js's GET /next-number.
  nextInvoiceNumber  Int     @default(1)
  defaultInvoiceMemo String? @db.Text

  // Chosen once at signup (server/src/routes/auth.js's POST /signup) and
  // never blank — drives default seed data (src/lib/seed.js's
  // buildSeedUserData) and default nav/route/settings gating everywhere
  // else. See server/src/lib/verticals.js for the canonical list + helpers.
  vertical            String  @default("band_orchestra")
  // Account-wide unlock of every vertical's tools, independent of the
  // `vertical` default above — flipped manually by a platform admin only
  // (same manual-only shape as disabledAt above).
  allVerticalsEnabled Boolean @default(false)

  // GigWorks' own subscription (what the business pays GigWorks) — entirely
  // separate from the Stripe Connect fields above (what the business's own
  // clients pay them). Direct Customer/Subscription objects on the
  // platform's Stripe account, never created with a {stripeAccount} option.
  // See server/src/lib/plans.js for the tier table and
  // server/src/routes/subscriptionWebhooks.js for what keeps this in sync.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Mirrors Stripe's own subscription status verbatim ('trialing' |
  // 'active' | 'past_due' | 'canceled' | 'unpaid' | 'incomplete' |
  // 'incomplete_expired'). Null means this account has never started a
  // checkout — distinct from any of the real statuses, and deliberately
  // never gated on in membership.js's attachMembership, so accounts that
  // predate billing (or that an admin created directly) aren't affected.
  subscriptionStatus   String?
  planTier             String? // 'solo' | 'team' | 'studio' — see lib/plans.js
  billingInterval      String? // 'month' | 'year'
  // Denormalized from planTier so team.js's invite route can check the seat
  // cap with a plain count query, no Stripe API call needed per invite.
  seatLimit            Int?
  trialEndsAt          DateTime?
}

model Membership {
  id          String   @id @default(cuid())
  role        String   @default("member") // 'owner' | 'admin' | 'member'
  permissions Json     @default("{}")
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

// Raw token is emailed to the user and never stored — only its hash, so a
// DB read alone can't be replayed to take over an account (same reasoning
// as passwordHash on User).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime

  // PrismaSessionStore prunes expired rows on a 2-minute timer (see
  // server/src/index.js) — without this, that's a seq scan every tick.
  @@index([expiresAt])
}

model BackgroundJobLease {
  name      String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Contractors/events themselves still live in the frontend's localStorage
// (see server/README.md) — eventId/contractorId below are opaque strings
// from that blob, not real FKs. accountId is the only real relation, and is
// what scopes every read so different EVL accounts never see each other's
// threads.
model EmailThread {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  eventId         String
  contractorId    String
  contractorEmail String

  // "reply+<this.id>@<RESEND_INBOUND_DOMAIN>" — null until a domain is
  // configured. Set once and never recomputed, since a contractor's mail
  // client keeps replying to whatever address a past email actually had.
  replyToAlias  String?
  subjectHint   String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages EmailMessage[]

  @@unique([accountId, eventId, contractorId])
  @@index([accountId])
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  direction   String // 'outbound' | 'inbound'
  fromAddress String
  toAddress   String
  subject     String
  body        String @db.Text

  templateId      String?
  sentByUserId    String?
  resendMessageId String? @unique
  inReplyTo       String?
  references      String?

  readAt    DateTime? // inbound-only; null = unread
  createdAt DateTime  @default(now())

  // inbound-only — Claude's read on whether this reply means the contractor
  // is confirming or declining the gig. 'confirmed' | 'declined' | 'ambiguous',
  // or null if classification hasn't run (outbound/manual messages, or the
  // classifier errored/was unavailable). See emailReplyClassifier.js.
  aiClassification String?

  @@index([threadId, createdAt])
}

// The team's shared contractors/clients/events/bookings/settings, as a
// single JSON blob per account (mirrors the shape the frontend used to keep
// in localStorage, keyed by userId — now shared across every member of the
// account instead of siloed per browser).
model AccountData {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  data      Json
  // Optimistic-concurrency guard for PUT /account-data — every write is
  // conditioned on the version the client last read, so two team members
  // saving near-simultaneously (each holding a full, possibly-stale copy of
  // this blob — see this model's doc comment above) can't silently clobber
  // one another; the loser gets a 409 and retries against the fresh copy.
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Two-way support conversation between an account and the platform admin —
// deliberately mirrors EmailThread/EmailMessage's shape (direction as a
// plain string, accountId scoping, lastMessageAt/readAt) since that's this
// codebase's established pattern for threaded messages.
model SupportThread {
  id           String  @id @default(cuid())
  ticketNumber Int     @unique @default(autoincrement()) // human-facing, sequential across the whole platform
  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subject             String
  status              String   @default("open") // 'open' | 'closed'
  priority            String   @default("normal") // 'low' | 'normal' | 'high' | 'urgent'
  // Required when closing (see PATCH /support/threads/:id) — cleared together on reopen.
  closedReason        String? // 'completed' | 'not_completed' | 'other'
  closedReasonDetail  String?  @db.Text
  // Set once by the customer after a thread closes (see PATCH /threads/:id/rating) —
  // not cleared on reopen, so re-closing later just leaves the prior rating in place
  // until the customer rates again.
  satisfactionRating  Int?
  satisfactionComment String?  @db.Text
  lastMessageAt       DateTime @default(now())
  createdAt           DateTime @default(now())

  // Which admin owns this ticket — notifications route to them instead of
  // the shared support inbox once set (see notifyAdmin in routes/support.js).
  assignedAdminId String?
  assignedAdmin   User?   @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)

  // "reply+support-<this.id>@<RESEND_INBOUND_DOMAIN>" — null until a domain
  // is configured. Set once and never recomputed, same reasoning as
  // EmailThread.replyToAlias above.
  replyToAlias String?

  messages SupportMessage[]
  notes    SupportNote[]

  @@index([accountId])
}

model SupportMessage {
  id       String        @id @default(cuid())
  threadId String
  thread   SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  direction    String // 'user' | 'admin'
  senderUserId String
  body         String @db.Text

  resendMessageId String?             @unique
  attachments     SupportAttachment[]

  readAt    DateTime? // null = unread by the other side
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
}

model SupportAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  size        Int
  // See EventDocument.data/storageKey (server/prisma/schema.prisma) for the storage-migration reasoning.
  data        Bytes?
  storageKey  String?

  createdAt DateTime @default(now())

  @@index([messageId])
}

// Admin-only annotations on a support thread — never sent to or visible by
// the account. Kept as its own model rather than a flag on SupportMessage so
// the customer-facing route (server/src/routes/support.js) can't leak these
// just by forgetting a filter.
model SupportNote {
  id       String        @id @default(cuid())
  threadId String
  thread   SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String @db.Text

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// Uploaded reference documents (stage plots, floor plans, contracts) for an
// event's prep sheet. Stored directly in Postgres (Bytes) rather than an
// external object store — no new service to configure, fine at this scale.
model EventDocument {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  eventId        String? // opaque localStorage id, same non-FK pattern as EmailThread; null for
  // account-level attachments not tied to an event (e.g. Set List library songs)
  filename       String
  contentType    String
  size           Int
  // Bytes live in Supabase Storage (see server/src/lib/fileStorage.js),
  // referenced by storageKey — data/storageKey are mutually exclusive in
  // practice: rows written before this migration only have `data`; every
  // row written after only has `storageKey`. Both stay nullable so each can
  // stand in for the other depending on which a given row has.
  data           Bytes?
  storageKey     String?
  // Unguessable, stable public identifier for this file — generated for
  // every document at upload/copy time (server/src/routes/eventDocuments.js)
  // and never regenerated, so a link built from it stays valid across every
  // future email it's included in. Distinct from `id`: `id` is also usable
  // as an authenticated lookup key elsewhere, so a separate token keeps the
  // public download route (server/src/routes/eventDocuments.js's
  // publicSongSheetsRouter) from doubling as a general-purpose-by-id public
  // fetch for every document type — only Set List songs actually surface
  // this token in a UI. Nullable so pre-migration rows (created before this
  // field existed) simply have none.
  //
  // Same split as InquiryLink's tokenHash/publicToken: shareTokenHash is the
  // actual public-route lookup key (so a DB dump alone can't produce a
  // usable link), and shareToken is a plaintext copy kept only because the
  // frontend needs to redisplay/rebuild the download URL later (Set List
  // library reuse) — same reasoning InquiryLink.publicToken documents.
  shareToken     String? @unique
  shareTokenHash String? @unique

  createdAt DateTime @default(now())

  @@index([accountId, eventId])
}

// Uploaded files for a booking's Proposal/Contract tabs — same non-FK
// bookingId pattern as EventDocument.eventId above. category distinguishes
// which tab a file belongs to.
model BookingDocument {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  bookingId   String // opaque localStorage id, same non-FK pattern as EventDocument.eventId
  category    String // 'proposal' | 'contract'
  filename    String
  contentType String
  size        Int
  // See EventDocument.data/storageKey above for the storage-migration reasoning.
  data        Bytes?
  storageKey  String?

  createdAt DateTime @default(now())

  @@index([accountId, bookingId])
}

// A booking's proposal, moved into a contract for signature. snapshot is
// frozen at send time (business/client/event details + line items) so later
// edits to the booking or proposal don't retroactively change a contract
// that's already out for signature. Client and owner each get their own
// one-time sign token — only its hash is stored, same reasoning as
// PasswordResetToken (a DB read alone can't be replayed into a signature).
// The owner's token lets them sign from the emailed link even when signed
// out (e.g. on the move); they can also sign in-app via requireAuth routes,
// whichever comes first.
model Contract {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  bookingId String // opaque localStorage id, same non-FK pattern as EventDocument.eventId

  snapshot Json
  // Unlike everything in snapshot (frozen at send time), terms stays live —
  // editable at any point in the contract's lifecycle, independent of
  // status, and always read fresh when rendering/viewing the PDF.
  terms    String? @db.Text
  status   String  @default("sent") // 'sent' | 'client_signed' | 'owner_signed' | 'fully_signed'

  recipientEmail String
  recipientName  String?
  ownerEmail     String

  clientTokenHash String? @unique
  ownerTokenHash  String? @unique

  clientSignedAt       DateTime?
  clientSignatureName  String?
  clientSignatureImage String?   @db.Text

  ownerSignedAt       DateTime?
  ownerSignatureName  String?
  ownerSignatureImage String?   @db.Text

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Audit trail: { id, at, type, note, actorEmail }[] — 'sent' | 'manual_sent'
  // | 'owner_signed' | 'client_signed' | 'terms_edited' | 'note'. actorEmail
  // is always a stamped string snapshot (same reasoning as ownerEmail above),
  // never a live User reference. Owner-only — never sent to the public,
  // token-based sign page.
  log Json @default("[]")

  @@index([accountId, bookingId])
}

// A client's response to a sent proposal — Accept (optionally with a note)
// or Request Revision (with a mandatory note explaining what needs to
// change). Simpler than Contract: one recipient, one token, no signature,
// and status is a plain flow rather than Contract's either-party-first
// derivation. snapshot is frozen at send time, same reasoning as
// Contract.snapshot — a later edit to the booking/proposal shouldn't
// retroactively change what the client is looking at or already responded
// to. A resend (e.g. after a revision request) creates a new row rather
// than overwriting this one, same as Contract.
model ProposalResponse {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  bookingId String // opaque localStorage id, same non-FK pattern as Contract.bookingId

  snapshot Json
  status   String @default("sent") // 'sent' | 'accepted' | 'revision_requested'

  recipientEmail String
  recipientName  String?
  ownerEmail     String

  tokenHash String? @unique

  respondedAt  DateTime?
  responseNote String?   @db.Text // optional on accept, required on revision request

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Audit trail: { id, at, type, note, actorEmail }[] — 'sent' | 'manual_sent'
  // | 'accepted' | 'revision_requested' | 'note'. Same shape/reasoning as
  // Contract.log — owner-only, never sent to the public respond page.
  log Json @default("[]")

  @@index([accountId, bookingId])
}

// A link the agent sends a prospective client so they can self-report their
// own event details (name/contact, date, bride/groom names, venue) without
// writing directly into the account's Client/Booking data — that data is a
// single whole-blob-replace JSON column (see AccountData), so an
// unauthenticated public endpoint must never touch it directly. The agent
// reviews `response` and explicitly "applies" it through the normal
// authenticated addClient/addBooking(orUpdateBooking) flow client-side; this
// row just tracks the link's lifecycle. Usually standalone (sent before any
// booking exists), but optionally tied to one via `bookingId` when sent from
// an in-progress Booking to fill in the remaining gaps — see `bookingId`.
model InquiryLink {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Raw token only ever exists in the URL/email — same reasoning as
  // Invoice.payTokenHash. Unlike Contract's sign tokens, the public view has
  // no email-confirmation gate (the prospect's email may not be known yet),
  // so possession of the token alone is the credential.
  tokenHash   String    @unique
  // Plaintext copy of the same token, set only on isReusable rows. Every
  // other link type is a one-time secret that's already been delivered by
  // the time anyone needs it again (only the hash matters), but a reusable
  // link is meant to be looked up and redisplayed indefinitely (e.g. every
  // time the owner opens Settings) — hashing alone can't support that. Not
  // a meaningful security regression: this URL is *designed* to be public
  // (pasted on the business's own website), so storing it in the clear here
  // is no different from any other public link a business owns.
  publicToken String?   @unique
  // 'open' -> 'submitted' -> 'applied' — each transition is one-way and
  // enforced by the routes (a used token can't be viewed/submitted again).
  // Regenerating a still-'open' link (lost/expired) reuses the same row —
  // it just swaps tokenHash/expiresAt, no new status. Doesn't apply to
  // isReusable rows below, which stay 'open' forever.
  status      String    @default("open")
  // Null means "never expires" — only true for isReusable rows.
  expiresAt   DateTime?

  // Marks the one account-wide "general" link a business can paste on their
  // own website (see server/src/routes/inquiryLinks.js's /reusable-link
  // routes) rather than a normal per-recipient link. Never transitions to
  // 'submitted'/'applied' itself — each public submission against it instead
  // creates a brand-new ordinary (isReusable: false) InquiryLink row, so the
  // shared link keeps working for the next visitor and every submission
  // still flows through the same review/apply path as any other inquiry.
  isReusable Boolean @default(false)

  // Opaque id (same non-FK pattern as Contract.bookingId) of the Booking
  // this link was sent from, if any — set when the agent already started a
  // booking manually and just wants the client to fill in the rest. Applying
  // a response with this set merges into that existing Booking instead of
  // creating a new one (see src/lib/applyInquiry.js).
  bookingId String?

  // Set only if the agent typed a known email at link-creation time, to
  // drive the optional "email this link now" send. Purely informational —
  // the public routes never gate on it.
  recipientEmail String?
  recipientName  String?
  ownerEmail     String

  // The client's submission — a single opaque blob (like Contract.snapshot)
  // since it's write-once, read-by-owner-then-turned-into-real-records, not
  // queried by individual field. Null until status is 'submitted'/'applied'.
  response    Json?
  submittedAt DateTime?

  // Set once the agent applies it — opaque ids, same non-FK pattern as
  // Contract.bookingId, purely for reference (not used to prevent re-apply;
  // status already guards that).
  appliedAt        DateTime?
  appliedBookingId String?
  appliedClientId  String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([accountId])
  @@index([accountId, bookingId])
}

// A billable invoice for a booking, paid online via Stripe Connect directly
// into the account's own connected Stripe account (see Account.stripeAccountId
// above) — GigWorks never touches the funds. Unlike Contract (frozen and
// sent in one step), an invoice has a real draft stage: snapshot/dueDate/memo
// stay editable while status is 'draft', then lock once sent, mirroring the
// spirit of Contract's frozen snapshot without a separate always-live field
// (there's no "terms" equivalent an invoice needs to keep editing post-send).
// A booking can have several invoices over time (e.g. deposit + balance), so
// reads are always a list, unlike Contract's effective one-per-booking.
// No stored total — always computed from snapshot.lineItems via
// computeOfferingsTotal() (src/lib/offerings.js), same as Proposal never
// storing a redundant total either.
model Invoice {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  bookingId String // opaque localStorage id, same non-FK pattern as Contract.bookingId

  // Editable by the owner; defaults to Account.nextInvoiceNumber at create
  // time. Not DB-unique — editing it to fix/jump the sequence is expected,
  // and enforcing uniqueness would turn that into an error-prone edit.
  number        Int?
  snapshot      Json // { businessInfo, client, lineItems: Offering[] }
  dueDate       DateTime?
  memo          String?   @db.Text
  // Off for invoices whose actual payment is handled outside GigWorks (a
  // separate invoicing tool, a check already arranged, etc.) — sending one
  // then skips the Stripe-connected gate entirely, and the public pay page
  // shows no Pay button, just the document itself.
  acceptPayment Boolean   @default(true)

  status           String  @default("draft") // 'draft' | 'sent' | 'partial' | 'paid' | 'void'
  // How much of the total has been recorded as paid — set to the full total
  // automatically by the Stripe webhook, or entered by hand when marking an
  // offline (cash/check/etc.) payment. Null/0 while still 'sent'.
  paidAmount       Float?
  // Only set by the manual "Accept Payment" popover (mark-payment status
  // 'paid') — Stripe's own webhook payments leave these null since the
  // method/reference are implicit (always a card, via the pay link).
  paymentMethod    String? // 'ach' | 'check' | 'card' | 'other'
  paymentReference String? // check number, only meaningful when method is 'check'
  paymentMemo      String? @db.Text // internal note about the payment, separate from the client-facing `memo` above

  recipientEmail String
  recipientName  String?
  ownerEmail     String

  // Raw token emailed once, only its hash persisted — same reasoning as
  // Contract's clientTokenHash/PasswordResetToken.tokenHash. Only one role
  // (the client) ever needs a pay link, unlike Contract's client+owner pair.
  payTokenHash String? @unique

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  sentAt        DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  receiptSentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([accountId, bookingId])
}

// A follow-up reminder, optionally tied to a client, contractor, event,
// invoice, or booking — relatedId is an opaque id into that record's own
// table (or, for a rule-generated event/invoice reminder, whatever
// relatedType says), same non-FK pattern as EventDocument.eventId. Manual
// reminders can link to any of the five (see ReminderModal.jsx's picker);
// rule-generated ones only ever use 'event' or 'invoice' today (see
// reminderRuleEngine.js's ruleKey constants). relatedName is a snapshot
// label taken at create/edit time so the reminder still reads sensibly even
// if the underlying record is later renamed or deleted — ReminderModal.jsx
// is careful to only ever overwrite it when the picker actually resolves a
// live record, never to null it out just because a lookup came up empty.
model Reminder {
  id              String  @id @default(cuid())
  accountId       String
  account         Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  relatedType String? // 'contractor' | 'client' | 'event' | 'invoice'
  relatedId   String?
  relatedName String?

  // Rule-generated reminders (see server/src/lib/reminderRuleEngine.js) vs.
  // manually created ones (server/src/routes/reminders.js's POST /, the only
  // other writer). ruleKey identifies which rule+record produced this row —
  // always null for manual reminders. The unique constraint below lets the
  // rule engine re-run on every tick without ever creating a duplicate for
  // the same record; Postgres treats each NULL ruleKey as distinct, so
  // manual reminders are never affected by it.
  autoGenerated Boolean @default(false)
  ruleKey       String?

  note           String    @db.Text
  remindAt       DateTime
  // Whether an email alert should be sent when remindAt is reached — see
  // server/src/lib/reminderScheduler.js. emailSentAt guards against
  // re-sending on every poll tick once it's gone out; it's reset to null
  // whenever remindAt is edited so a moved reminder can still email at its
  // new time.
  emailEnabled   Boolean   @default(false)
  emailSentAt    DateTime?
  // Atomic per-row claim so multiple concurrently-running backend instances
  // (see server/src/lib/reminderScheduler.js) never both send the same
  // reminder's email — claimed via a conditional updateMany, not a DB-level
  // lock (advisory locks don't compose safely with connection pooling).
  // Treated as stale after 5 minutes so a claim from a crashed instance
  // doesn't permanently block the reminder from ever being retried.
  emailClaimedAt DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, relatedType, relatedId, ruleKey])
  @@index([accountId, remindAt])
  @@index([emailEnabled, emailSentAt, completedAt, remindAt, id], map: "reminder_due_email_idx")
  @@index([autoGenerated, emailSentAt, emailClaimedAt, completedAt], map: "reminder_auto_resolution_idx")
}

// A business's own sending domain, self-service configured in Settings —
// see server/src/lib/emailDomains.js. One per account. Two provisioning
// paths, distinguished by isCustomDomain:
//  - false: a gigworks.io subdomain (e.g. "acme.gigworks.io") — this
//    account controls gigworks.io's DNS, so the required records are
//    written automatically via GoDaddy's API.
//  - true: a business's own domain (e.g. "mail.acmeevents.com") — DNS is
//    out of this app's control, so `dnsRecords` are shown as copy-paste
//    instructions instead of being written anywhere.
// `domain` is always the full domain either way. resendDomainId/dnsRecords
// mirror what Resend's Domains API returned at creation time so status can
// be re-checked without re-deriving the records. Accounts without a row
// here (or with one that isn't 'verified') keep sending from the
// platform's own default domain — see resolveFromHeader/resolveReplyDomain
// in server/src/lib/mailer.js.
model EmailDomain {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  domain         String    @unique
  isCustomDomain Boolean   @default(false)
  resendDomainId String    @unique
  status         String    @default("pending") // 'pending' | 'verified' | 'failed'
  dnsRecords     Json // Resend's returned record list — auto-applied (GoDaddy) or shown as instructions, per isCustomDomain
  verifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A band/orchestra event's stage plot — one document per event (opaque
// eventId, same non-FK pattern as EventDocument.eventId, since Events live
// in AccountData.data, not a real table), made of one or more pages plus a
// structured I/O/channel list. Scene data lives here (real tables) rather
// than in the AccountData JSON blob deliberately: the canvas editor fires
// many rapid position updates while dragging and needs point-in-time
// undo/redo, and AuthContext's updateCurrentUser rewrites the *entire*
// account blob on every save with no debouncing — routing scene edits
// through that would blow up write volume and risk clobbering unrelated
// concurrent edits elsewhere in the account. See
// src/lib/canvasEngine/history.js for why undo/redo itself stays
// client-side/session-only rather than adding to this problem further.
model StagePlot {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId   String

  name          String                  @default("Stage Plot")
  pages         StagePlotPage[]
  channels      StagePlotChannel[]
  backlineItems StagePlotBacklineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, eventId])
  @@index([accountId])
}

// One page's scene graph — src/lib/canvasEngine/sceneModel.js's shape
// (elements/strokes/annotations/layers/scale). Stored per page (not one
// blob per document) so autosaving a single page in a multi-page plot never
// rewrites every other page's data. thumbnailStorageKey is a PNG snapshot
// (canvas.toDataURL(), uploaded via server/src/lib/fileStorage.js) kept in
// sync on save — jsPDF has no canvas renderer, so PDF export embeds this
// browser-rendered image rather than re-drawing the scene server-side.
model StagePlotPage {
  id          String    @id @default(cuid())
  stagePlotId String
  stagePlot   StagePlot @relation(fields: [stagePlotId], references: [id], onDelete: Cascade)

  order               Int
  name                String  @default("Page 1")
  scene               Json    @default("{}")
  thumbnailStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stagePlotId, order])
}

// The standard live-sound input list — kept as real rows (not embedded in
// scene JSON) since it's tabular data a business sorts/edits/exports
// independently of the visual plot. elementId optionally links a channel to
// a specific icon placed on a page without making the canvas element's
// position depend on this row (or vice versa).
model StagePlotChannel {
  id          String    @id @default(cuid())
  stagePlotId String
  stagePlot   StagePlot @relation(fields: [stagePlotId], references: [id], onDelete: Cascade)

  channelNumber Int
  source        String // instrument/role, e.g. "Lead Vocals" — see StagePlotChannelList.jsx's "Instrument" column
  musicianName  String?
  phantomPower  Boolean @default(false) // "48V" in the UI
  powerNeeded   Boolean @default(false) // AC power at this position
  monitorNotes  String? @db.Text
  elementId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stagePlotId, channelNumber])
  @@index([stagePlotId])
}

// Equipment the venue/production needs to have on hand (amps, drum kit,
// risers, monitors) — kept as real rows next to the I/O list above, same
// "tabular data a business edits independently of the visual plot"
// reasoning. Not linked to a canvas element like a channel can be — backline
// is about gear on the rider, not a specific icon placed on the plot.
// notesHtml is rich text (bold/italic/underline/size via RichTextToolbar,
// same contentEditable pattern as CanvasStage.jsx's icon popup and
// PrepEmailModal.jsx) rather than plain text like StagePlotChannel's
// monitorNotes — a backline note is often a whole spec ("Fender Twin or
// equivalent, must have reverb") worth actually formatting.
model StagePlotBacklineItem {
  id          String    @id @default(cuid())
  stagePlotId String
  stagePlot   StagePlot @relation(fields: [stagePlotId], references: [id], onDelete: Cascade)

  item       String
  quantity   Int     @default(1)
  providedBy String? // 'band' | 'venue' | 'rental' | null (TBD)
  notesHtml  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stagePlotId])
}

// A party-planning event's floor plan — deliberately separate models from
// StagePlot/StagePlotPage above rather than shared rows, the direct
// technical expression of "two independently-built tools" (confirmed with
// the user) rather than one reskinned engine. No channel-list equivalent:
// floor plans don't have an industry-standard tabular counterpart the way
// stage plots have an I/O list.
model FloorPlan {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId   String

  name  String          @default("Floor Plan")
  pages FloorPlanPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, eventId])
  @@index([accountId])
}

model FloorPlanPage {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  order               Int
  name                String  @default("Page 1")
  scene               Json    @default("{}")
  thumbnailStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorPlanId, order])
}

// A party-planning event's guest list — real rows (not embedded in
// AccountData.data like the rest of Events/Bookings/Contractors) for two
// reasons: the public RSVP flow below needs to resolve a token to "which
// account/event" without loading (or being able to search across) every
// account's JSON blob, and once guest data has to live in a real table for
// that, the authenticated Guests tab reads/writes the same rows rather than
// maintaining a second, disconnected list.
model Guest {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId   String // opaque localStorage id, same non-FK pattern as EventDocument.eventId

  name       String
  email      String?
  phone      String?
  partySize  Int     @default(1)
  rsvpStatus String  @default("invited") // 'invited' | 'confirmed' | 'declined'
  notes      String? @db.Text

  // 'rsvp_link' rows were created by a guest through the public link below;
  // 'manual' rows were entered directly by the planner. Purely informational.
  source String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, eventId])
}

// A business's vendor/crew roster — the first entity graduated out of
// AccountData.data purely for blob-size reasons (see today's scalability
// discussion): unlike Guest/StagePlot/FloorPlan, nothing here needed a
// public unauthenticated route, but Contractors is one of the few lists on
// an account that grows unboundedly over its lifetime rather than staying
// naturally small, so it's one of the first candidates to actually hit the
// ~100KB save-size ceiling. Events still reference a contractor by plain
// `contractorId` string in their own blob-stored `contractorBookings[]` —
// same opaque non-FK pattern already used everywhere else in this schema
// (see EventDocument.eventId), not a real relation.
//
// `id` has no @default: the create route requires the caller to supply one
// (see routes/contractors.js) so blob-migration preserves the original id
// instead of minting a new one out from under any existing contractorId
// reference — see Booking/Event's model comments below for why this matters
// there far more than it does here.
model Contractor {
  id        String  @id
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  firstName  String
  middleName String?
  lastName   String
  email      String?
  phone      String?

  contractorType1 String?
  contractorType2 String?
  // [{ id, name, price }] — small and tightly coupled to the contractor
  // itself, no need for its own table (unlike Guest, which is independently
  // queried/written by the public RSVP route).
  pricingTiers    Json    @default("[]")
  priceNotes      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, createdAt, id])
}

// A business's client/customer roster — same graduation-out-of-the-blob
// reasoning as Contractor above (see that model's comment): grows
// unboundedly over an account's lifetime, one of the pieces most likely to
// actually hit the account-data blob's ~100KB save-size ceiling. Bookings
// and Events still reference a client by plain `clientId` string in their
// own blob-stored data — same opaque non-FK pattern as everywhere else in
// this schema (see EventDocument.eventId), not a real relation.
//
// `id` has no @default — same id-preservation reasoning as Contractor above.
model Client {
  id        String  @id
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  notes     String? @db.Text

  portalTokens ClientPortalToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, createdAt, id])
}

// Magic-link login for the client-facing self-service portal (server/src/
// routes/portal.js) — same shape and reasoning as PasswordResetToken: only
// the hash is ever stored, so a DB read alone can't be replayed to log in as
// someone else. A real Client.passwordHash-style credential was deliberately
// not built instead: Client.email is optional/unenforced/non-unique today,
// which is a poor foundation for a durable password account but a fine one
// for a short-lived, single-use link re-requested each time.
model ClientPortalToken {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

// A business's Booking pipeline — the pre-Event stage (inquiry through
// signed contract) before staffing/logistics begin. Graduated out of the
// blob for the same reasons as Contractor/Client, but unlike those two,
// Booking and Event are referenced by opaque id from many other real
// tables: Contract.bookingId, Invoice.bookingId, BookingDocument.bookingId,
// InquiryLink.bookingId, and Booking.convertedEventId (which points at an
// Event). None of those are enforced FKs — same opaque-string pattern as
// everywhere else in this schema — which means nothing breaks if migration
// preserves the original id, but WOULD silently orphan every one of those
// references if it didn't. `id` therefore has no @default: the create route
// requires the caller to supply it (see routes/bookings.js), and the
// migration script passes through each blob record's existing id unchanged.
//
// eventDate/depositDueDate/nextFollowUpDate/contractSignedDate are plain
// strings, not DateTime — see lib/format.js's formatEventDate, which
// deliberately treats these as opaque 'YYYY-MM-DD' text to avoid a
// UTC-shift bug that a real DATE/TIMESTAMP column would reintroduce.
model Booking {
  id        String  @id
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  eventName          String?
  clientId           String?
  eventDate          String?
  eventType          String?
  brideName          String?
  groomName          String?
  // String, not Int — BookingFormPage keeps this as a raw <input> string
  // (only ever `Number()`-parsed inline for display/math), same reasoning
  // as the date fields above.
  guestCount         String?
  depositAmount      Float?
  depositDueDate     String?
  depositPaid        Boolean   @default(false)
  depositType        String?   @default("fixed")
  // String, not Float — same reasoning as guestCount above.
  depositPercent     String?
  bookingStatus      String?
  priority           String?
  nextFollowUpDate   String?
  contractSignedDate String?
  referralSource     String?
  notes              String?   @db.Text
  convertedEventId   String?
  deletedAt          DateTime?
  // Distinct from deletedAt — a completed booking is done, not gone; it
  // stays fully intact and just moves out of the active list into the
  // Completed tab (BookingsPage.jsx). Set/cleared via a plain PATCH, same
  // mechanism as deletedAt.
  completedAt        DateTime?

  venue       Json  @default("{}")
  schedule    Json  @default("[]")
  activityLog Json  @default("[]")
  // Not defaulted (nullable instead) — distinguishes "never pushed to
  // Proposal" from "has an empty proposal object," which BookingFormPage's
  // pipeline stepper cares about.
  proposal    Json?
  history     Json  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, deletedAt, createdAt, id])
  // Queried directly by the reminder rule engine and the deleted-record
  // purger (both scan across accounts), not just filtered client-side —
  // see server/src/lib/reminderRuleEngine.js and deletedRecordPurger.js.
  @@index([convertedEventId])
}

// A business's staffed/logistics event — created either standalone or by
// converting a Booking (Booking.convertedEventId then points here). Same
// id-preservation reasoning as Booking above: referenced by opaque id from
// EventDocument.eventId, StagePlot.eventId, FloorPlan.eventId,
// Guest.eventId, EventRsvpLink.eventId, Invoice.bookingId's own event chain,
// and SetList storage — `id` has no @default for the same reason.
model Event {
  id        String  @id
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name                       String?
  eventType                  String?
  eventDate                  String?
  eventDayOfTheWeek          String?
  clientId                   String?
  brideName                  String?
  groomName                  String?
  // String, not Int — same reasoning as Booking.guestCount above.
  guestCount                 String?
  contactPhone               String?
  contactPhoneExt            String?
  contactEmail               String?
  startTime                  String?
  endTime                    String?
  eventNote                  String?   @db.Text
  prepNotes                  String?   @db.Text
  eventStatus                String?
  noOutsideContractorsNeeded Boolean   @default(false)
  deletedAt                  DateTime?
  // Same "done, not gone" reasoning as Booking.completedAt above.
  completedAt                DateTime?

  venue              Json @default("{}")
  contractorBookings Json @default("[]")
  categoryTabs       Json @default("[]")
  schedule           Json @default("[]")
  prepGroups         Json @default("[]")
  requests           Json @default("[]")
  shotList           Json @default("[]")
  secondShooters     Json @default("[]")
  otherExpenses      Json @default("[]")
  history            Json @default("[]")
  setLists           Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, deletedAt, createdAt, id])
  @@index([accountId, deletedAt, completedAt, eventDate, id])
}

// The one shareable RSVP link per event — a guest visiting it adds
// themselves to that event's Guest list above. Deliberately always
// "reusable" (unlike InquiryLink's per-recipient links): every visitor uses
// the same link and the same token, so there's no single-use status to
// track. tokenHash is what the public route actually looks up by;
// publicToken is a plaintext copy of the same value so the owner can
// re-view/copy the link from the Guests tab anytime without it being
// consumed — same reasoning as InquiryLink.publicToken.
model EventRsvpLink {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventId   String

  tokenHash   String @unique
  publicToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, eventId])
}

// A persistent, non-expiring link per contractor (unlike ClientPortalToken's
// 30-min magic link) showing that contractor their own gig calendar —
// meant to be bookmarked/added to a home screen, not re-requested each
// visit. Same tokenHash/publicToken shape as EventRsvpLink for the same
// reason: tokenHash is what the public route looks up by (a DB dump alone
// can't produce a usable link), publicToken is the plaintext copy shown
// to the owner to re-view/copy anytime without consuming it.
model ContractorCalendarLink {
  id           String  @id @default(cuid())
  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contractorId String

  tokenHash   String @unique
  publicToken String @unique

  // Owner-configurable — lets a business hide pending/tentative gigs from
  // a contractor's own view (e.g. don't want them seeing an unconfirmed
  // booking) without hiding confirmed ones too. Unavailable/declined gigs
  // are never shown regardless of these flags (not really "theirs"
  // anymore) — see the public route's filtering logic.
  showConfirmed Boolean @default(true)
  showTentative Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, contractorId])
}

// Submissions from the public marketing site (gigworks.io) — someone who
// doesn't have an account yet, so this is deliberately NOT scoped to an
// Account like everything else in this file. Two shapes share one table
// (`type` distinguishes them) since they're the same "who reached out and
// why" record either way; splitting into two models would just be two
// near-identical tables with no behavioral difference.
model WaitlistEntry {
  id           String   @id @default(cuid())
  type         String // 'waitlist' | 'contact'
  name         String
  email        String
  businessName String?
  message      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
}
