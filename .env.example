# Base URL of the backend API (see server/). Points at local dev by default.
# For production builds, set this to a relative `/api` path, NOT the direct
# Railway URL — vercel.json proxies /api/* to Railway so the browser only
# ever talks to the frontend's own domain, keeping the session cookie
# first-party. Pointing this straight at the Railway URL instead makes it a
# genuine cross-site request, which modern browsers increasingly block as a
# third-party cookie regardless of SameSite=None — that's what broke
# signup/login in production before this was added.
VITE_API_BASE=http://localhost:4000/api
